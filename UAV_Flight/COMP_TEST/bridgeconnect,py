import v2v_bridge

def main():
    bridge = v2v_bridge.V2VBridge("/dev/ttyUSB0", baud=115200, name="UAV-Bridge")
    bridge.connect()

    # Send a test message
    test_message = "Hi Cody and Julian"
    bridge.send_message(test_message)
    print(f"Sent message: {test_message}")

    # Send CMD_MOVE_2FT command
    bridge.send_command(1, v2v_bridge.CMD_MOVE_2FT, 0)
    print("Sent command: CMD_MOVE_2FT")

    bridge.stop()

if __name__ == "__main__":
    main()