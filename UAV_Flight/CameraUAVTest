from pymavlink import mavutil # using the confirmed mavlink pattern instead of dronekit
import time # for timing and sleeps
import sys # for clean exits
import v2v_bridge # our custom radio bridge talker
import cv2 # for aruco detection
import pyzed.sl as sl # zed 2 sdk on jetson nano

# uav mission 4 - aruco gate -> takeoff -> aruco land trigger
# phase 1: scan for aruco on the ground before arming (pre-flight gate)
# phase 2: take off and hover, command the rover circles
# phase 3: scan for aruco again in the air - when seen, land

################################# config

CONNECTION_STRING = "/dev/ttyACM0"   # drone wire
BAUD_RATE = 57600                    # confirmed baud
ESP32_PORT = "/dev/ttyUSB0"          # radio bridge usb

TARGET_ALT = 1.3    # hover height in meters
CIRCLE_TIME = 18.0  # duration for rover maneuvers

THROTTLE_MIN = 1000
THROTTLE_IDLE = 1150
THROTTLE_CLIMB = 1650
THROTTLE_HOVER = 1500

ARUCO_DICT_TYPE = cv2.aruco.DICT_4X4_50  # must match your printed marker
ARUCO_PREFLIGHT_TIMEOUT = 30.0           # seconds to wait for marker before aborting on the ground
ARUCO_LAND_TIMEOUT = 0.0                 # 0 = wait forever in the air until marker appears (set a value to add timeout)

################################# mavlink helpers (unchanged from working code)

def change_mode(master, mode: str):
    mapping = master.mode_mapping()
    if mode not in mapping:
        print(f"Unknown mode '{mode}'")
        return
    mode_id = mapping[mode]
    master.mav.set_mode_send(master.target_system, mavutil.mavlink.MAV_MODE_FLAG_CUSTOM_MODE_ENABLED, mode_id)
    print(f"Mode set: {mode}")
    time.sleep(1)

def arm_drone(master):
    master.mav.command_long_send(
        master.target_system, master.target_component,
        mavutil.mavlink.MAV_CMD_COMPONENT_ARM_DISARM, 0, 1, 0, 0, 0, 0, 0, 0
    )
    print("Arming motors...")
    time.sleep(2)

def disarm_drone(master):
    master.mav.command_long_send(
        master.target_system, master.target_component,
        mavutil.mavlink.MAV_CMD_COMPONENT_ARM_DISARM, 0, 0, 0, 0, 0, 0, 0, 0
    )
    print("Disarmed.")

def set_throttle(master, pwm):
    master.mav.rc_channels_override_send(
        master.target_system, master.target_component,
        0, 0, pwm, 0, 0, 0, 0, 0
    )

def get_lidar_alt(master):
    msg = master.recv_match(type='DISTANCE_SENSOR', blocking=True, timeout=1.0)
    if msg:
        return msg.current_distance / 100.0
    return 0.0

################################# aruco helper - reused for both scan phases

def build_aruco_detector():
    # builds the detector once, reused for both the preflight scan and the land trigger scan
    aruco_dict = cv2.aruco.getPredefinedDictionary(ARUCO_DICT_TYPE)
    aruco_params = cv2.aruco.DetectorParameters()
    return cv2.aruco.ArucoDetector(aruco_dict, aruco_params)

def open_zed(depth=False):
    # opens the zed 2 camera. depth=False for preflight scan (saves cpu), depth can stay off for land trigger too
    cam = sl.Camera()
    init_params = sl.InitParameters()
    init_params.camera_resolution = sl.RESOLUTION.HD720
    init_params.camera_fps = 30
    init_params.depth_mode = sl.DEPTH_MODE.NONE  # no depth needed for either scan phase
    status = cam.open(init_params)
    if status != sl.ERROR_CODE.SUCCESS:
        print(f"[ZED] Failed to open: {status}")
        return None
    return cam

def scan_for_marker(cam, detector, timeout=0.0, label=""):
    """
    Scans frames from an already-open ZED camera until a marker is detected.
    timeout=0.0 means wait forever (used for the in-air land trigger).
    timeout>0 means abort after that many seconds (used for preflight gate).
    Returns detected marker ID (int) or None on timeout.
    """
    zed_image = sl.Mat()
    scan_start = time.time()
    print(f"[ArUco{' ' + label if label else ''}] Scanning for marker... {'(timeout: ' + str(timeout) + 's)' if timeout > 0 else '(waiting indefinitely)'}")

    while True:
        elapsed = time.time() - scan_start

        # only check timeout if one was set
        if timeout > 0 and elapsed >= timeout:
            print(f"[ArUco] Timeout after {timeout}s. No marker found.")
            return None

        if cam.grab() == sl.ERROR_CODE.SUCCESS:
            cam.retrieve_image(zed_image, sl.VIEW.LEFT)
            frame = zed_image.get_data()
            frame_bgr = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
            gray = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2GRAY)

            corners, ids, _ = detector.detectMarkers(gray)

            if ids is not None and len(ids) > 0:
                detected_id = int(ids[0][0])
                print(f"\n[ArUco] Marker detected! ID: {detected_id}")
                return detected_id

            print(f"[ArUco] Scanning... {elapsed:.1f}s", end='\r')

        time.sleep(0.05)  # ~20fps, easy on the nano

################################# main mission

def main():
    print("==========================================")
    print("   UAV MISSION 4 - ARUCO GATE + LAND TRIGGER")
    print("==========================================")

    # connect to flight controller
    print(f"Connecting to Drone: {CONNECTION_STRING}...")
    master = mavutil.mavlink_connection(CONNECTION_STRING, baud=BAUD_RATE)
    master.wait_heartbeat()
    print("Drone Heartbeat OK.")

    # connect radio bridge
    bridge = v2v_bridge.V2VBridge(ESP32_PORT, name="UAV-Bridge")
    try:
        bridge.connect()
        bridge.send_message("MISSION 4: START")
    except:
        print("Radio Bridge Fail.")
        return

    try:
        # ==========================================
        # PHASE 1: PRE-FLIGHT ARUCO GATE (on ground, motors OFF)
        # show the marker to the camera to authorize the flight
        # if no marker is seen within the timeout, we never arm
        # ==========================================
        print("\n--- PHASE 1: PRE-FLIGHT ARUCO SCAN (motors off) ---")
        detector = build_aruco_detector()  # build once, reuse in phase 3
        cam = open_zed()
        if cam is None:
            print("[!] ZED failed to open. Aborting.")
            bridge.stop()
            return

        preflight_id = scan_for_marker(cam, detector, timeout=ARUCO_PREFLIGHT_TIMEOUT, label="PREFLIGHT")
        cam.close()  # close camera between phases to free usb bandwidth
        print("[ZED] Camera closed after preflight scan.")

        if preflight_id is None:
            print("[!] No marker seen. Aborting mission - drone will NOT arm.")
            bridge.stop()
            return

        print(f"[ArUco] Preflight gate PASSED (ID:{preflight_id}). Arming...")
        bridge.send_message(f"PREFLIGHT GATE PASSED: ID {preflight_id}")

        # ==========================================
        # PHASE 2: ARM + TAKEOFF + ROVER MISSION
        # identical to the original working mission4 code
        # ==========================================
        print("\n--- PHASE 2: TAKEOFF AND ROVER MISSION ---")
        change_mode(master, "STABILIZE")
        arm_drone(master)

        # climb to target altitude
        print("Climbing to 1.3m...")
        while True:
            alt = get_lidar_alt(master)
            print(f" Altitude: {alt:.2f}m", end='\r')
            if alt >= TARGET_ALT:
                set_throttle(master, THROTTLE_HOVER)
                print(f"\nHover altitude reached: {alt:.2f}m")
                break
            set_throttle(master, THROTTLE_CLIMB)
            time.sleep(0.1)

        # sync with rover
        print("Waiting for UGV sync...")
        while True:
            set_throttle(master, THROTTLE_HOVER)  # keep heartbeat alive
            data = bridge.get_telemetry()
            if data:
                print("UGV Ready. Initiating Circles.")
                break
            time.sleep(0.2)

        # command rover circles
        bridge.send_command(cmdSeq=400, cmd=v2v_bridge.CMD_CIRCLE, estop=0)

        start_t = time.time()
        while (time.time() - start_t) < CIRCLE_TIME:
            data = bridge.get_telemetry()
            if data:
                print(f" UGV Speed: {data[2]:.2f} m/s", end='\r')

            alt = get_lidar_alt(master)
            if alt < TARGET_ALT - 0.1:
                set_throttle(master, THROTTLE_HOVER + 100)
            elif alt > TARGET_ALT + 0.1:
                set_throttle(master, THROTTLE_HOVER - 100)
            else:
                set_throttle(master, THROTTLE_HOVER)

            time.sleep(0.1)

        # ==========================================
        # PHASE 3: IN-AIR ARUCO LAND TRIGGER
        # hover and hold altitude while scanning for the marker
        # the moment the marker is seen, we initiate landing
        # no timeout - it waits as long as needed
        # ==========================================
        print("\n--- PHASE 3: HOVERING - SHOW MARKER TO LAND ---")
        bridge.send_message("PHASE 3: SHOW MARKER TO LAND")

        cam = open_zed()  # reopen the camera for the land trigger scan
        if cam is None:
            # camera failed - just land anyway rather than hover forever
            print("[!] ZED failed to open for land trigger. Landing now.")
        else:
            # keep sending throttle while the zed scans
            # we do this by checking the camera and sending throttle on each loop iteration
            zed_image = sl.Mat()
            scan_start = time.time()
            land_trigger_seen = False

            print("[ArUco] Hovering and scanning for land trigger marker...")

            while not land_trigger_seen:
                # altitude hold - must send every cycle or drone drops
                alt = get_lidar_alt(master)
                if alt < TARGET_ALT - 0.1:
                    set_throttle(master, THROTTLE_HOVER + 100)
                elif alt > TARGET_ALT + 0.1:
                    set_throttle(master, THROTTLE_HOVER - 100)
                else:
                    set_throttle(master, THROTTLE_HOVER)

                # scan one frame
                if cam.grab() == sl.ERROR_CODE.SUCCESS:
                    cam.retrieve_image(zed_image, sl.VIEW.LEFT)
                    frame = zed_image.get_data()
                    frame_bgr = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
                    gray = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2GRAY)

                    corners, ids, _ = detector.detectMarkers(gray)

                    if ids is not None and len(ids) > 0:
                        land_id = int(ids[0][0])
                        print(f"\n[ArUco] Land trigger marker seen! ID:{land_id} - Initiating landing.")
                        bridge.send_message(f"LAND TRIGGER: ID {land_id}")
                        land_trigger_seen = True  # exit the scan loop
                    else:
                        elapsed = time.time() - scan_start
                        print(f" [ArUco] Hovering, waiting for marker... {elapsed:.1f}s  Alt:{alt:.2f}m", end='\r')

                time.sleep(0.1)  # 10hz - matches the altitude hold loop rate from mission4

            cam.close()
            print("[ZED] Camera closed after land trigger.")

        # ==========================================
        # LAND - same as original mission4 landing
        # ==========================================
        print("\nLanding sequence engaged...")
        change_mode(master, "LAND")
        set_throttle(master, 0)  # release override so autopilot takes over

        while True:
            alt = get_lidar_alt(master)
            print(f" Land Alt: {alt:.2f}m", end='\r')
            msg = master.recv_match(type='HEARTBEAT', blocking=False)
            if msg and not (msg.base_mode & mavutil.mavlink.MAV_MODE_FLAG_SAFETY_ARMED):
                print("\nTouchdown confirmed. Motors stopped.")
                break
            time.sleep(0.5)

    except KeyboardInterrupt:
        print("\n[!] Emergency: User Triggered Landing...")
        change_mode(master, "LAND")
        set_throttle(master, 0)
        time.sleep(1)
    finally:
        bridge.stop()
        print("Mission finalized.")

if __name__ == "__main__":
    main()
